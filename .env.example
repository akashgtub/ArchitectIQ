# ArchitectIQ - Environment Configuration
# Copy this file to .env and configure your values.

# Gemini / Gemma Model Configuration
# Required for live architecture image interpretation.
# Model recommendation:
# - 'gemini-2.0-flash' or 'gemini-1.5-flash' for multimodal vision + structured JSON output
# - 'gemma-2-27b-it' if using text-only Gemma via Gemini API with extracted OCR/text
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_BASE_URL=

# Member 2 Simulator Integration
# Set SIMULATOR_BASE_URL to Member 2's simulator HTTP endpoint once deployed.
# When empty or USE_MOCK_SIMULATOR=true, a deterministic mock simulator is used.
SIMULATOR_BASE_URL=http://localhost:8001
SIMULATOR_TIMEOUT_SECONDS=30
USE_MOCK_SIMULATOR=true

# Root-Cause Investigation Limits (Safety Budget)
MAX_DIAGNOSTIC_EXPERIMENTS=3
INVESTIGATION_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=5
MAX_RETRIES=2
PER_CALL_TIMEOUT_SECONDS=30

# Image Ingestion & Validation Limits
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
