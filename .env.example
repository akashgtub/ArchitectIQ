# ArchitectIQ - Environment Configuration
# Copy this file to .env and configure your values.

# AI Provider & Model Configuration
# Options: 'auto', 'gemma', 'gemini', 'deterministic_fallback'
AI_PROVIDER=auto
ALLOW_AI_FALLBACK=true

# Google Gemini Configuration (Multimodal Vision + Reasoning)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.0-flash
GEMINI_BASE_URL=

# Google Gemma Configuration (Instruction-Tuned Text Reasoning)
# Supports Google AI Studio, Vertex AI, or OpenAI-compatible inference servers (vLLM, Ollama, Groq)
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-2-27b-it
GEMMA_BASE_URL=

# Simulation Engine Integration
# ArchitectIQ runs the real physics-based discrete simulation engine by default (USE_MOCK_SIMULATOR=false).
# Mock mode is only active when explicitly set to true for unit tests or offline demo.
# If SIMULATOR_BASE_URL is set, client calls external HTTP service; if empty, runs in-process engine.
USE_MOCK_SIMULATOR=false
SIMULATOR_BASE_URL=
SIMULATOR_TIMEOUT_SECONDS=30

# Root-Cause Investigation Limits (Safety Budget)
MAX_DIAGNOSTIC_EXPERIMENTS=3
INVESTIGATION_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=5
MAX_RETRIES=2
PER_CALL_TIMEOUT_SECONDS=30

# Image Ingestion & Validation Limits
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION=4096
