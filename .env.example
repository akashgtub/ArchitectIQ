# ArchitectIQ - Environment Configuration
# Copy this file to .env and configure your values.

# AI Provider & Model Configuration
# Options for AI_PROVIDER: 'auto', 'huggingface', 'gemini', 'gemma', 'deterministic_fallback'
AI_PROVIDER=huggingface
ALLOW_AI_FALLBACK=true

# Optional task-specific provider overrides:
# VISION_AI_PROVIDER: Used for architecture diagram image analysis (e.g. 'gemini')
VISION_AI_PROVIDER=gemini
# TEXT_AI_PROVIDER: Used for root-cause and trade-off analysis (e.g. 'huggingface')
TEXT_AI_PROVIDER=huggingface

# Hugging Face Inference Providers Configuration (Text reasoning)
# Uses OpenAI-compatible chat endpoint: https://router.huggingface.co/v1/chat/completions
HF_TOKEN=hf_your_huggingface_token_here
HF_MODEL=google/gemma-2-27b-it
HF_BASE_URL=https://router.huggingface.co/v1

# Google Gemini Configuration (Multimodal Vision + Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-flash-latest
GEMINI_BASE_URL=

# Google Gemma Configuration (Direct Google API / Custom Host fallback)
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-2-27b-it
GEMMA_BASE_URL=

# Simulation Engine Integration
# ArchitectIQ runs the real physics-based discrete simulation engine by default (USE_MOCK_SIMULATOR=false).
# Mock mode is only active when explicitly set to true for unit tests or offline demo.
# If SIMULATOR_BASE_URL is set, client calls external HTTP service; if empty, runs in-process engine.
USE_MOCK_SIMULATOR=false
SIMULATOR_BASE_URL=
SIMULATOR_TIMEOUT_SECONDS=30

# Root-Cause Investigation Limits (Safety Budget)
MAX_DIAGNOSTIC_EXPERIMENTS=3
INVESTIGATION_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=5
MAX_RETRIES=2
PER_CALL_TIMEOUT_SECONDS=30

# Image Ingestion & Validation Limits
MAX_IMAGE_SIZE_BYTES=10485760
MAX_IMAGE_DIMENSION=4096

# Environment & Server Settings
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=*

