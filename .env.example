# ArchitectIQ - Environment Configuration
# Copy this file to .env and configure your values.

# Google Gemini / GenAI Configuration (Multimodal Vision + Reasoning)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Persistence Database Configuration
DATABASE_URL=sqlite:///./architectiq.db

# Frontend Application Origin & Upload Limits
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=10
LOG_LEVEL=INFO

# AI Provider Configuration
# Options: 'auto', 'gemini', 'gemma', 'huggingface', 'deterministic_fallback'
AI_PROVIDER=auto
ALLOW_AI_FALLBACK=true

# Optional Task-Specific Provider Overrides
VISION_AI_PROVIDER=gemini
TEXT_AI_PROVIDER=gemini

# Optional Alternative: Hugging Face Inference Providers (Text Reasoning)
HF_TOKEN=
HF_MODEL=google/gemma-2-27b-it
HF_BASE_URL=https://router.huggingface.co/v1

# Simulation Engine Integration
# ArchitectIQ runs the real discrete-event simulation engine by default.
USE_MOCK_SIMULATOR=false
SIMULATOR_BASE_URL=
SIMULATOR_TIMEOUT_SECONDS=30

# Root-Cause Diagnostic Budget Limits
MAX_DIAGNOSTIC_EXPERIMENTS=3
INVESTIGATION_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS=5
MAX_RETRIES=2
PER_CALL_TIMEOUT_SECONDS=30
